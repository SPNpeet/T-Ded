# คัดลอกเป็น .env แล้วแก้ค่า
DATABASE_URL=sqlite://data/teedet.db
PORT=8787
WEB_DIR=web/dist
RUST_LOG=info,sqlx=warn

# บัญชีแอดมินตัวแรก (สร้างให้อัตโนมัติตอนเริ่มถ้ายังไม่มี)
ADMIN_PHONE=0800000000
ADMIN_PIN=123456
ORG_NAME=หน่วยส่งเสริม ทีเด็ดปลาน้ำจืด

# LINE Messaging API (ไม่บังคับ ใส่แล้วเปิดสรุปเช้า/บันทึกผ่านแชท)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADD_FRIEND_URL=

# จำกัด origin (ไม่ใส่ = อนุญาตทุก origin สำหรับตอนพัฒนา)
CORS_ORIGIN=
